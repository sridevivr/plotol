# --- LLM ---
ANTHROPIC_API_KEY=

# --- Signal sources ---

# SEC EDGAR full-text search is the primary signal source for the default
# labor-intel ICP. Public and auth-free; the SEC requires a User-Agent that
# identifies you with contact info.
EDGAR_ENABLED=true
EDGAR_USER_AGENT=signalforge contact@example.com

# Greenhouse + Lever public boards are a thin coverage source (most $500M+
# enterprises use Workday/iCIMS). Comma-separated board tokens for each.
# Title filters target: Director of Workforce Planning, VP Workforce Planning,
# Head of Workforce Planning, Director of Labor Planning/Analytics/Strategy,
# Director of Store/Retail/Field Operations, Director of Real Estate,
# Head of Talent Acquisition.
GREENHOUSE_BOARDS=
LEVER_BOARDS=

# --- Enrichment waterfall ---
# Pick one of Apollo or Ocean.io for firmographics; both can be set and the
# waterfall will use Apollo first, Ocean.io as fallback.
APOLLO_API_KEY=
OCEANIO_API_KEY=

BUILTWITH_API_KEY=

# Proxycurl resolves the champion person at the target company by role +
# company_name. Cost: ~3 credits per person found (~$0.015). Free tier
# includes 10 credits.
PROXYCURL_API_KEY=

# Hard cap on Proxycurl HTTP calls per pipeline run. Set lower for cost
# control; a single record can spend up to roles.length (currently 7) calls
# in the worst case before giving up.
PROXYCURL_MAX_CALLS=50

# --- CRM ---
# HubSpot developer sandbox private app token.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# --- Reporting ---
# Where the weekly static HTML lands. Defaults to ./reports/generated.
REPORT_OUTPUT_DIR=./reports/generated

# --- Observability ---
# Optional Slack webhook for v1.1 alerting.
SLACK_WEBHOOK_URL=
