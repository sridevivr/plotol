# --- LLM ---
ANTHROPIC_API_KEY=

# --- Signal sources ---
# Greenhouse + Lever boards are public; no key required for v1.
# Optional: a comma-separated list of Greenhouse board tokens to scope the scan.
GREENHOUSE_BOARDS=
LEVER_BOARDS=

# --- Enrichment waterfall ---
# Pick one of Apollo or Ocean.io for firmographics; both can be set and the
# waterfall will use Apollo first, Ocean.io as fallback.
APOLLO_API_KEY=
OCEANIO_API_KEY=

BUILTWITH_API_KEY=
PROXYCURL_API_KEY=

# --- CRM ---
# HubSpot developer sandbox private app token.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# --- Reporting ---
# Where the weekly static HTML lands. Defaults to ./reports/generated.
REPORT_OUTPUT_DIR=./reports/generated

# --- Observability ---
# Optional Slack webhook for v1.1 alerting.
SLACK_WEBHOOK_URL=
